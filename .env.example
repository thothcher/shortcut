# Copy to .env and fill in. Everything has a development default, so `npm run dev` works without this file.

# ── Site ──────────────────────────────────────────────
APP_NAME=Konspekti
# Public address of the platform (no trailing slash). In production: https://konspekti.ge
APP_URL=http://localhost:3000
# Books are served from <slug>.<BOOKS_DOMAIN>. Default: the APP_URL host (cbt.localhost:3000 in development).
# Production example: BOOKS_DOMAIN=konspekti.ge  →  https://cbt.konspekti.ge
# BOOKS_DOMAIN=
PORT=3000
# NODE_ENV=production
# Behind Caddy/nginx/Render/Railway set to 1 so the real visitor IP is used for rate limiting.
# TRUST_PROXY=1
# Required in production: any random string, 32+ characters (e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`)
# SESSION_SECRET=
# Where the database, book sites and covers are stored (needs a persistent disk in production).
# STORAGE_DIR=storage

# ── Plan ──────────────────────────────────────────────
# Price in tetri (1000 = 10 GEL) and how many days one payment gives.
PRICE_TETRI=1000
ACCESS_DAYS=30
# A login on one more device signs out the oldest one.
MAX_SESSIONS_PER_USER=2
# Faint e-mail watermark on book pages (on | off).
WATERMARK=on
MAX_UPLOAD_MB=400

# ── Payments: Flitt (https://docs.flitt.com) ─────────
# Leave empty to use the built-in test checkout (development only).
# Flitt's public test merchant: FLITT_MERCHANT_ID=1549901  FLITT_SECRET_KEY=test  (test card 4444555511116666)
# FLITT_MERCHANT_ID=
# FLITT_SECRET_KEY=

# ── E-mail (password reset) via https://resend.com ───
# Without a key, e-mails are printed to the console.
# RESEND_API_KEY=
# EMAIL_FROM="Konspekti <no-reply@konspekti.ge>"

# ── Company details (footer, legal pages; Flitt requires them on the site) ──
# COMPANY_NAME="ი/მ გივი ვახტანგიშვილი"
# COMPANY_ID=
# COMPANY_ADDRESS=
# CONTACT_EMAIL=
# CONTACT_PHONE=

# ── Book upload API (for the PDF converter) ──────────
# 24+ random characters. Send as "Authorization: Bearer <token>".
# ADMIN_API_TOKEN=
